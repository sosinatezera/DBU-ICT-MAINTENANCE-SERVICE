# ─────────────────────────────────────────────
# Smart Computer Maintenance Service — Environment
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# CORS — Allowed frontend origins (comma-separated)
FRONTEND_ORIGINS=https://smartcomputer-maintenance-system.netlify.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_DB_NAME=ict_maintenance_db

# JWT
JWT_SECRET=generate_a_strong_random_string_here
JWT_EXPIRES_IN=24h

# File Upload
UPLOAD_PATH=uploads/
MAX_FILE_SIZE=5242880

# ─────────────────────────────────────────────
# Email — Gmail SMTP (OPTIONAL — leave blank to disable all email delivery)
# ─────────────────────────────────────────────
# SMTP_PASS is a GOOGLE APP PASSWORD, NOT your normal Gmail password.
# How to create one:
#   1. Turn ON 2-Step Verification at https://myaccount.google.com/security
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an app password for "Mail" — you get a 16-character code
#   4. Paste that 16-char code into SMTP_PASS below (spaces are allowed)
# Never commit the real App Password. Your local .env is in .gitignore.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Smart Computer Maintenance Service
