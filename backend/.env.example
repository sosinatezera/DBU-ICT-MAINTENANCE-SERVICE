# ─────────────────────────────────────────────
# Smart ICT Maintenance Management System — Environment
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# CORS — Allowed frontend origins (comma-separated)
FRONTEND_ORIGINS=https://simms-mau.netlify.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5000,http://127.0.0.1:5000
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_DB_NAME=ict_maintenance_db

# Signed stateless bearer authentication
# Required in production; use a random value of at least 32 characters.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters

# Google Identity Services (ID-token sign-in)
# Create an OAuth 2.0 Web application client in Google Cloud Console.
# Configure authorized JavaScript origins for the Netlify site and localhost.
# This public client ID is shared with the frontend by GET /api/auth/google/config.
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Public registration is enabled in the application; public signups are
# always assigned the Requester role.

# File Upload
UPLOAD_PATH=uploads/
MAX_FILE_SIZE=5242880

# ─────────────────────────────────────────────
# Reverse proxy
# The deployment terminates TLS in front of Node, so the connecting socket
# address belongs to the proxy for EVERY caller. Trust the hop so req.ip is
# the real client — without it, per-IP rate limits collapse into one shared
# bucket for the entire user base.
# Use a NUMBER (number of proxy hops). Do NOT use "true": that would let a
# client spoof X-Forwarded-For and escape a rate limit.
# Leave unset → 1 in production, disabled in development.
# TRUST_PROXY=1

# ─────────────────────────────────────────────
# Rate limiting (optional overrides)
# Every auth endpoint has its own bucket. Password recovery is limited both per
# client IP and per target account, so a shared campus network can never exhaust
# one user's allowance and an attacker cannot lock a victim out.
# Defaults below are for production; development is far more permissive.
# Every value is "max requests per RATE_LIMIT_WINDOW_MS".
# RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=30                # POST /login + /register (per IP)
# RESET_PASSWORD_RATE_LIMIT_MAX=30      # POST /reset-password   (per IP)
# FORGOT_RATE_LIMIT_IP_MAX=20           # POST /forgot-password  (per IP)
# FORGOT_RATE_LIMIT_ACCOUNT_MAX=5      # POST /forgot-password  (per account)
# VERIFY_CODE_RATE_LIMIT_IP_MAX=60      # POST /verify-reset-code(per IP)
# VERIFY_CODE_RATE_LIMIT_ACCOUNT_MAX=10 # POST /verify-reset-code(per account)

# ─────────────────────────────────────────────
# Email — production uses Resend over HTTPS (port 443). Locally, select Resend
# with EMAIL_PROVIDER=resend or Gmail SMTP with EMAIL_PROVIDER=smtp.
# Configure RESEND_API_KEY and EMAIL_FROM in Render.
# EMAIL_FROM must belong to a domain verified in Resend.
# Never commit the real API key. Set Render values in its Environment settings.
# Set EMAIL_PROVIDER=resend locally to exercise the Resend API path.
# Leave the credential blank until a real Resend API key is available.
# When using local Gmail SMTP, SMTP_PASSWORD must be a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.account@gmail.com
SMTP_PASSWORD=your 16-char Google App Password
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
# SMTP_FROM_NAME=Smart ICT Maintenance Management System
# RESEND_TIMEOUT_MS=10000
# Set EMAIL_PROVIDER=smtp to use local SMTP; MAIL_FROM is optional there and
# defaults to SMTP_USER.
MAIL_FROM=
SMTP_FROM_NAME=Smart ICT Maintenance Management System

# SMS — Twilio (OPTIONAL — leave blank to disable SMS delivery)
# SMS_API_KEY is the Twilio Account SID; SMS_API_SECRET is the Auth Token.
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=

# ICT Admin inbox — receives every contact-form submission.
# REQUIRED: POST /api/inquiries stores the message in MongoDB and then emails
# this address, treating a non-delivery as a failed submission. Leaving it blank
# therefore makes the contact form answer HTTP 503 for EVERY visitor, even when
# email provider itself is perfectly healthy — the one failure mode with no other symptom.
# Not defaulted in code on purpose: set the real inbox here and in the hosting
# provider's environment (on Render: service -> Environment).
ADMIN_EMAIL=your.ict.admin.inbox@gmail.com

# AI Assistant — server-side inference provider. The browser NEVER connects
# directly to any AI provider; the backend is the only caller, and the API key
# never leaves the backend environment.
#
# Master AI uses Google Gemini AI Studio Free Tier only. Create a free key at
# https://aistudio.google.com/apikey and set it only in backend/.env or the
# backend host's secret environment. Never put the key in frontend code.
#
# Canonical AI API:
#   GET  /api/ai/health
#   GET  /api/ai/admin/status          (ICT Admin detail)
#   POST /api/ai/chat   { message, conversationId?, conversation?, stream? }
#
# ── Gemini (free hosted provider) ──
AI_PROVIDER=gemini
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional tuning (defaults are used when omitted):
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TIMEOUT_MS=120000        # full inference / stream timeout
# GEMINI_PING_TIMEOUT_MS=10000    # connectivity (GET /models) timeout
# GEMINI_MAX_TOKENS=1500          # max generated tokens per answer
AI_MAX_FILE_SIZE_MB=10
