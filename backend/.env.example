# ─────────────────────────────────────────────
# Smart ICT Maintenance Management System — Environment
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# CORS — Allowed frontend origins (comma-separated)
FRONTEND_ORIGINS=https://simms-ict-maintenance-system.netlify.app,https://smartcomputer-maintenance-system.netlify.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5000,http://127.0.0.1:5000
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_DB_NAME=ict_maintenance_db

# Server-side session
SESSION_SECRET=generate_a_strong_random_string_here
# 86,400,000 ms = 24 hours. Because the server runs express-session with
# `rolling: true` and `resave: true`, this is 24 hours of INACTIVITY, not 24
# hours from login: every authenticated request pushes the cookie expiry and
# the MongoDB session TTL forward. The cookie maxAge and the store TTL are both
# derived from this single value, so they cannot drift apart.
SESSION_TTL_MS=86400000

# ─────────────────────────────────────────────
# Session persistence verification (OPTIONAL)
# Consumed by:  npm run verify:session
# Supply ONE existing account per role so the harness can drive a real login
# -> refresh -> navigate -> idle -> logout cycle and report PASS/FAIL.
# Leave unset and that role is reported as SKIP, not PASS.
# Use throwaway local accounts. These are real passwords — keep them in the
# gitignored .env, never in a committed file.
# VERIFY_REQUESTER_EMAIL=
# VERIFY_REQUESTER_PASSWORD=
# VERIFY_TECHNICIAN_EMAIL=
# VERIFY_TECHNICIAN_PASSWORD=
# VERIFY_ADMIN_EMAIL=
# VERIFY_ADMIN_PASSWORD=
# Targets and the idle-pause length (defaults shown):
# VERIFY_API_URL=http://localhost:5000
# VERIFY_WEB_URL=http://localhost:3000
# VERIFY_ORIGIN=http://localhost:3000
# VERIFY_IDLE_MS=20000

# File Upload
UPLOAD_PATH=uploads/
MAX_FILE_SIZE=5242880

# ─────────────────────────────────────────────
# Reverse proxy
# The deployment terminates TLS in front of Node, so the connecting socket
# address belongs to the proxy for EVERY caller. Trust the hop so req.ip is
# the real client — without it, per-IP rate limits collapse into one shared
# bucket for the entire user base.
# Use a NUMBER (number of proxy hops). Do NOT use "true": that would let a
# client spoof X-Forwarded-For and escape a rate limit.
# Leave unset → 1 in production, disabled in development.
# TRUST_PROXY=1

# ─────────────────────────────────────────────
# Rate limiting (optional overrides)
# Every auth endpoint has its own bucket. Password recovery is limited both per
# client IP and per target account, so a shared campus network can never exhaust
# one user's allowance and an attacker cannot lock a victim out.
# Defaults below are for production; development is far more permissive.
# Every value is "max requests per RATE_LIMIT_WINDOW_MS".
# RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=30                # POST /login + /register (per IP)
# RESET_PASSWORD_RATE_LIMIT_MAX=30      # POST /reset-password   (per IP)
# FORGOT_RATE_LIMIT_IP_MAX=20           # POST /forgot-password  (per IP)
# FORGOT_RATE_LIMIT_ACCOUNT_MAX=5      # POST /forgot-password  (per account)
# VERIFY_CODE_RATE_LIMIT_IP_MAX=60      # POST /verify-reset-code(per IP)
# VERIFY_CODE_RATE_LIMIT_ACCOUNT_MAX=10 # POST /verify-reset-code(per account)

# ─────────────────────────────────────────────
# Email — Gmail SMTP (REQUIRED for password reset).
# Without these, password-reset codes cannot be emailed and the forgot-password
# endpoint answers 503 for every address.
#
# LOCAL vs DEPLOYED: this .env file is read ONLY when you run the backend on
# your own machine. A cloud deployment ignores it entirely — the same values
# must exist in the hosting provider's environment settings (on Render:
# service -> Environment), otherwise the service boots with email unusable and
# logs "EMAIL_CONFIGURATION_ERROR - PASSWORD RESET IS DISABLED".
#
# Diagnose a misconfigured provider with:  npm run verify:smtp
# It reports the failing stage (EMAIL_CONFIGURATION_ERROR / _CONNECTION_ERROR /
# _SEND_ERROR) and the names of any missing variables. It never prints a
# password, an App Password or a full email address.
# ─────────────────────────────────────────────
# SMTP_PASSWORD is a GOOGLE APP PASSWORD, NOT your normal Gmail password.
# How to create one:
#   1. Turn ON 2-Step Verification at https://myaccount.google.com/security
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an app password for "Mail" — you get a 16-character code
#   4. Paste that 16-char code into SMTP_PASSWORD below (spaces are allowed)
# Never commit the real App Password. Your local .env is in .gitignore.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.account@gmail.com
SMTP_PASSWORD=your 16-char Google App Password
# SMTP_PASS / SMTP_FROM_NAME are accepted as legacy aliases for
# SMTP_PASSWORD / MAIL_FROM for anyone already using the old names.
# MAIL_FROM: optional independent From address (defaults to SMTP_USER).
MAIL_FROM=
SMTP_FROM_NAME=Smart ICT Maintenance Management System

# SMS — Twilio (OPTIONAL — leave blank to disable SMS delivery)
# SMS_API_KEY is the Twilio Account SID; SMS_API_SECRET is the Auth Token.
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=

# ICT Admin inbox — receives every contact-form submission.
# REQUIRED: POST /api/inquiries stores the message in MongoDB and then emails
# this address, treating a non-delivery as a failed submission. Leaving it blank
# therefore makes the contact form answer HTTP 503 for EVERY visitor, even when
# SMTP itself is perfectly healthy — the one failure mode with no other symptom.
# Not defaulted in code on purpose: set the real inbox here and in the hosting
# provider's environment (on Render: service -> Environment).
ADMIN_EMAIL=your.ict.admin.inbox@gmail.com

# AI Assistant (server-side Ollama; the browser never connects to Ollama).
# Locally, use the Ollama process on this machine. Render's Blueprint derives
# the backend OLLAMA_BASE_URL from the private simms-ollama service host:port.
#
# Canonical API (mounted at both /api/assistant and /api/ai):
#   GET  /api/assistant/health          (public, lean)
#   GET  /api/assistant/admin/status    (ICT Admin detail: reachability, model list)
#   POST /api/assistant/chat   { message, conversationId?, conversation?, stream? }
#
# Ollama never reaches the browser directly — the backend is the only caller.
#
# Local Ollama setup:
#   1. Install Ollama from https://ollama.com
#   2. Start it: `ollama serve` (or the desktop app)
#   3. Pull the model once: `ollama pull llama3.2`
AI_SUPPORT_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
AI_MAX_FILE_SIZE_MB=10
# Optional tuning (defaults are used when omitted):
# OLLAMA_TIMEOUT_MS=120000        # full inference / stream timeout
# OLLAMA_PING_TIMEOUT_MS=3000     # connectivity (/api/tags) timeout
# OLLAMA_MAX_TOKENS=1500          # max generated tokens per answer
